table Dim_Date

	column Date
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		isKey
		sourceColumn: Date

	column Year = YEAR([Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column QuarterNum = QUARTER([Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column Quarter = "Q" & QUARTER([Date]) & " " & YEAR([Date])
		dataType: string
		summarizeBy: none
		sortByColumn: QuarterSort

	column QuarterSort = YEAR([Date]) * 10 + QUARTER([Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column MonthNum = MONTH([Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column MonthName = FORMAT([Date], "MMMM")
		dataType: string
		summarizeBy: none

	column MonthShort = FORMAT([Date], "MMM")
		dataType: string
		summarizeBy: none

	column MonthYear = FORMAT([Date], "MMM YYYY")
		dataType: string
		summarizeBy: none
		sortByColumn: MonthYearSort

	column MonthYearSort = YEAR([Date]) * 100 + MONTH([Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column Day = DAY([Date])
		dataType: int64
		formatString: 0
		summarizeBy: none

	column DayName = FORMAT([Date], "dddd")
		dataType: string
		summarizeBy: none
		sortByColumn: WeekdayNum

	column DayShort = FORMAT([Date], "ddd")
		dataType: string
		summarizeBy: none
		sortByColumn: WeekdayNum

	column WeekdayNum = WEEKDAY([Date], 2)
		dataType: int64
		formatString: 0
		summarizeBy: none

	column IsWeekend = WEEKDAY([Date], 2) >= 6
		dataType: boolean
		summarizeBy: none

	column IsCurrentMonth = YEAR([Date]) = YEAR(TODAY()) && MONTH([Date]) = MONTH(TODAY())
		dataType: boolean
		summarizeBy: none

	column IsCurrentYear = YEAR([Date]) = YEAR(TODAY())
		dataType: boolean
		summarizeBy: none

	partition Dim_Date = calculated
		mode: import
		source =
				CALENDAR(DATE(2025,1,1), DATE(2027,12,31))

	annotation PBI_Id = Dim_Date

