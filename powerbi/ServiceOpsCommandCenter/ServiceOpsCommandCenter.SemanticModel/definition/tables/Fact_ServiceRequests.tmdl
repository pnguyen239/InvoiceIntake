	column CreatedDate = DATE(YEAR([CreatedDateTime]), MONTH([CreatedDateTime]), DAY([CreatedDateTime]))
		lineageTag: 2edbc984-076a-4928-b7cf-ae0090099c32
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none

	column CompletedDate = IF(ISBLANK('Fact_ServiceRequests'[CompletedDateTime]), BLANK(), DATE(YEAR([CompletedDateTime]), MONTH([CompletedDateTime]), DAY([CompletedDateTime])))
		lineageTag: 9ccb2aff-2a30-4f43-b86c-73bc9b5ccf1e
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none

	column 'SLA Outcome' =
				VAR IsComp = 'Fact_ServiceRequests'[Status] = "Completed"
				VAR IsCanc = 'Fact_ServiceRequests'[Status] = "Cancelled"
				VAR Met = IsComp && 'Fact_ServiceRequests'[CompletedDateTime] <= 'Fact_ServiceRequests'[SLADueDateTime]
				VAR OverdueOpen = NOT IsComp && NOT IsCanc && 'Fact_ServiceRequests'[SLADueDateTime] < NOW()
				VAR SpanHrs = DATEDIFF('Fact_ServiceRequests'[CreatedDateTime], 'Fact_ServiceRequests'[SLADueDateTime], HOUR)
				VAR HrsLeft = DATEDIFF(NOW(), 'Fact_ServiceRequests'[SLADueDateTime], HOUR)
				VAR AtRisk = NOT IsComp && NOT IsCanc && HrsLeft > 0 && HrsLeft < SpanHrs * 0.25
				RETURN
				    SWITCH(
				        TRUE(),
				        IsCanc, "Cancelled",
				        IsComp && Met, "Met",
				        IsComp && NOT Met, "Breached",
				        OverdueOpen, "Breached",
				        AtRisk, "At Risk",
				        "On Track"
				    )
		lineageTag: 76a65534-eb6f-4aa3-a827-5933f65a5c51
		dataType: string
		summarizeBy: none

	column AgingHours = IF('Fact_ServiceRequests'[IsOpen], DATEDIFF('Fact_ServiceRequests'[CreatedDateTime], NOW(), MINUTE) / 60, BLANK())
		lineageTag: c727205b-d788-427e-9c56-c9a20ca0e087
		dataType: double
		formatString: 0.0
		summarizeBy: none

	column AgingBucketSort =
				IF(
				    NOT 'Fact_ServiceRequests'[IsOpen],
				    BLANK(),
				    SWITCH(
				        TRUE(),
				        'Fact_ServiceRequests'[AgingHours] <= 24, 1,
				        'Fact_ServiceRequests'[AgingHours] <= 72, 2,
				        'Fact_ServiceRequests'[AgingHours] <= 168, 3,
				        'Fact_ServiceRequests'[AgingHours] <= 336, 4,
				        5
				    )
				)
		lineageTag: a650acca-a173-408d-ac5a-8c23913aa953
		dataType: int64
		formatString: 0
		summarizeBy: none

	column AgingBucket =
				IF(
				    NOT 'Fact_ServiceRequests'[IsOpen],
				    BLANK(),
				    SWITCH(
				        TRUE(),
				        'Fact_ServiceRequests'[AgingHours] <= 24, "0-1 Day",
				        'Fact_ServiceRequests'[AgingHours] <= 72, "1-3 Days",
				        'Fact_ServiceRequests'[AgingHours] <= 168, "3-7 Days",
				        'Fact_ServiceRequests'[AgingHours] <= 336, "7-14 Days",
				        "14+ Days"
				    )
				)
		lineageTag: 260c0d58-f37d-4e9c-8c94-d4d180a0e871
		dataType: string
		summarizeBy: none
		sortByColumn: AgingBucketSort

	column IsUnassignedStage = 'Fact_ServiceRequests'[Status] = "New" || 'Fact_ServiceRequests'[Status] = "Assigned"
		lineageTag: 99b36275-b8e3-4c98-aa09-4459d7fb540a
		dataType: boolean
		summarizeBy: none

