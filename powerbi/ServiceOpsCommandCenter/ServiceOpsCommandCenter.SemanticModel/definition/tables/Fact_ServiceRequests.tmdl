	measure 'Total Requests' = COUNTROWS('Fact_ServiceRequests')
		lineageTag: ce7a549c-4d7f-4a0f-8416-96b6d2d0cbb2
		formatString: #,0

	measure 'Open Requests' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[IsOpen] = TRUE)
		lineageTag: a1388b1c-b24b-4428-b890-17be118a1f70
		formatString: #,0

	measure 'Completed Requests' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[Status] = "Completed")
		lineageTag: 14500bc7-bfab-4960-aff6-764dc5aece01
		formatString: #,0

	measure 'Cancelled Requests' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[Status] = "Cancelled")
		lineageTag: 1743b59c-8c7f-4d19-9b1d-57c774f13a0f
		formatString: #,0

	measure 'Backlog Volume' = [Open Requests]
		lineageTag: 8c3ce2c6-4513-4b71-b03e-c846b4033575
		formatString: #,0

	measure 'Unassigned Requests' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[IsUnassignedStage] = TRUE)
		lineageTag: c27da6dd-ac63-4902-b40e-823320ae6cfe
		formatString: #,0

	measure 'Open Over 3 Days' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[IsOpen] = TRUE, 'Fact_ServiceRequests'[AgingHours] > 72)
		lineageTag: 24e0df34-e3d4-407d-992a-96a1de729399
		formatString: #,0

	measure 'Cancellation Rate' = DIVIDE([Cancelled Requests], [Total Requests])
		lineageTag: 733c8d2f-940d-4271-b3cb-9e219ad514ea
		formatString: 0.0%

	measure 'Resolved Requests (Completed Date)' = CALCULATE([Completed Requests], USERELATIONSHIP('Fact_ServiceRequests'[CompletedDate], 'Dim_Date'[Date]))
		lineageTag: 059f97a9-e2eb-48e8-8e1a-881585d427fb
		formatString: #,0

	measure 'SLA Met' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[SLA Outcome] = "Met")
		lineageTag: c324909a-5d5d-4bbc-ad2f-01bc77b3fdff
		formatString: #,0

	measure 'SLA Breached' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[SLA Outcome] = "Breached")
		lineageTag: f8b1cbde-01c7-47bd-a20a-26b4207da8a9
		formatString: #,0

	measure 'SLA At Risk' = CALCULATE([Total Requests], 'Fact_ServiceRequests'[SLA Outcome] = "At Risk")
		lineageTag: 29f9331f-6298-4e94-9105-e0ce725398cd
		formatString: #,0

	measure 'SLA Compliance %' = DIVIDE([SLA Met], [Completed Requests])
		lineageTag: e7ff0dbd-054e-4f22-a0e6-f451a912f9ee
		formatString: 0.0%

	measure 'SLA Target %' = 0.90
		lineageTag: ef1828a7-62b7-482b-bd8d-3a44dba8e0c4
		formatString: 0%

	measure 'Average Resolution Time (Hrs)' = AVERAGE('Fact_ServiceRequests'[ResolutionHours])
		lineageTag: cb988191-842a-4f1d-946b-5d2e53993233
		formatString: 0.0

	measure 'Average Time to Start (Hrs)' = AVERAGE('Fact_ServiceRequests'[TimeToStartHours])
		lineageTag: 78b58202-6e5e-41b4-bcd5-f70221ccc7d1
		formatString: 0.0

	measure 'Average Handling Time (Hrs)' = AVERAGE('Fact_ServiceRequests'[HandlingHours])
		lineageTag: 9bf32a02-5691-4af4-8652-0c72d049a6bd
		formatString: 0.0

	measure 'Average Hold Time (Hrs)' = DIVIDE(AVERAGE('Fact_ServiceRequests'[HoldMinutesTotal]), 60)
		lineageTag: 54f985a5-8c90-4e68-8222-70971c389681
		formatString: 0.0

	measure 'Previous Period Requests' =
			VAR CurrentDates = DATESBETWEEN('Dim_Date'[Date], MIN('Dim_Date'[Date]), MAX('Dim_Date'[Date]))
			VAR DayCount = COUNTROWS(CurrentDates)
			VAR PeriodStart = MIN('Dim_Date'[Date]) - DayCount
			VAR PeriodEnd = MIN('Dim_Date'[Date]) - 1
			RETURN
			    CALCULATE([Total Requests], DATESBETWEEN('Dim_Date'[Date], PeriodStart, PeriodEnd))
		lineageTag: 7b8c8ba7-0d56-41d6-8b8a-ceb9c3debcd2
		formatString: #,0

	measure 'Period Variance' = [Total Requests] - [Previous Period Requests]
		lineageTag: 8e15b47c-2814-460c-a156-40d0f2c3a395
		formatString: +#,0;-#,0;0

	measure 'Period Variance %' = DIVIDE([Period Variance], [Previous Period Requests])
		lineageTag: 53e75e53-9958-4366-9af5-16c526ca4ab5
		formatString: +0.0%;-0.0%;0%

	measure 'Requests PM' = CALCULATE([Total Requests], DATEADD('Dim_Date'[Date], -1, MONTH))
		lineageTag: c255e185-1eac-4b54-aa22-bcfb26ac050e
		formatString: #,0

	measure 'MoM Change %' = DIVIDE([Total Requests] - [Requests PM], [Requests PM])
		lineageTag: e0113665-42f2-4b7e-8bf7-f21920f76d66
		formatString: +0.0%;-0.0%;0%

	measure 'Requests PQ' = CALCULATE([Total Requests], DATEADD('Dim_Date'[Date], -1, QUARTER))
		lineageTag: 37b75efc-cbc3-4ec9-811c-f9334700079e
		formatString: #,0

	measure 'QoQ Change %' = DIVIDE([Total Requests] - [Requests PQ], [Requests PQ])
		lineageTag: e814e2ce-80ff-43f2-a3d0-ca811f5ff8e7
		formatString: +0.0%;-0.0%;0%

	measure 'Requests PY' = CALCULATE([Total Requests], SAMEPERIODLASTYEAR('Dim_Date'[Date]))
		lineageTag: 7543ff79-52d2-4d2a-a03e-4d43b949f457
		formatString: #,0

	measure 'YoY Change %' = DIVIDE([Total Requests] - [Requests PY], [Requests PY])
		lineageTag: 003b17da-c878-46c4-b108-e5ea9656b693
		formatString: +0.0%;-0.0%;0%

	measure 'Rolling 3 Month Volume' = CALCULATE([Total Requests], DATESINPERIOD('Dim_Date'[Date], MAX('Dim_Date'[Date]), -3, MONTH))
		lineageTag: dd1cb2c0-fe06-4dd1-9493-7563530e1f5d
		formatString: #,0

	measure 'Rolling 6 Month Volume' = CALCULATE([Total Requests], DATESINPERIOD('Dim_Date'[Date], MAX('Dim_Date'[Date]), -6, MONTH))
		lineageTag: ef9859a2-4ed2-470c-9b3f-6e3a7d90c81b
		formatString: #,0

	measure 'Rolling 12 Month Volume' = CALCULATE([Total Requests], DATESINPERIOD('Dim_Date'[Date], MAX('Dim_Date'[Date]), -12, MONTH))
		lineageTag: 903e56ab-29fb-473f-8959-cee1ada04f17
		formatString: #,0

	measure 'YTD Requests' = TOTALYTD([Total Requests], 'Dim_Date'[Date])
		lineageTag: eea8ef49-46db-4c7d-8f71-83a85c443cd2
		formatString: #,0

	measure 'YTD SLA Compliance' = CALCULATE([SLA Compliance %], DATESYTD('Dim_Date'[Date]))
		lineageTag: a7268a67-cc2e-4478-982c-41816cee6158
		formatString: 0.0%

	measure 'YTD Resolution Time' = CALCULATE([Average Resolution Time (Hrs)], DATESYTD('Dim_Date'[Date]))
		lineageTag: f83ccc21-1d22-4d4f-ab4b-fd5fd0ae20af
		formatString: 0.0

	measure 'Reporting Period Label' =
			VAR MinD = MIN('Dim_Date'[Date])
			VAR MaxD = MAX('Dim_Date'[Date])
			RETURN
			    IF(
			        MinD = MaxD,
			        FORMAT(MinD, "MMMM d, yyyy"),
			        FORMAT(MinD, "MMMM yyyy") & " – " & FORMAT(MaxD, "MMMM yyyy")
			    )

	annotation PBI_Id = Fact_ServiceRequests

		lineageTag: 0ad7f949-1124-4087-b9aa-3cb4abc7d566