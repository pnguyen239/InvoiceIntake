table Fact_StatusHistory

	column StatusHistoryKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		isKey
		sourceColumn: StatusHistoryKey

	column RequestKey
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RequestKey

	column Status
		dataType: string
		summarizeBy: none
		sourceColumn: Status

	column StatusTimestamp
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: StatusTimestamp

	column StatusDate
		dataType: dateTime
		formatString: Short Date
		summarizeBy: none
		expression: DATE(YEAR([StatusTimestamp]), MONTH([StatusTimestamp]), DAY([StatusTimestamp]))

